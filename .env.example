# ============================================================
# Production-Oriented AI Research Agent Configuration
# ============================================================

# LLM Provider Configuration
# Supported providers: "openai", "openrouter", "ollama", "mock"
LLM_PROVIDER=openai

# OpenAI API Key (Required if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# Model name (e.g., gpt-4o-mini, gpt-4o, gpt-3.5-turbo)
OPENAI_MODEL=gpt-4o-mini

# Optional: Custom Base URL for OpenAI-compatible proxies / local servers (e.g. Ollama or vLLM)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Enable Mock Mode for zero-cost, offline deterministic testing and CI runs
# Set to 'true' to run without calling external LLM APIs
MOCK_MODE=false

# Search Configuration
# Max search results per query
SEARCH_MAX_RESULTS=5

# Network Timeouts & Retries
TOOL_TIMEOUT_SECONDS=10
TOOL_MAX_RETRIES=3
TOOL_RETRY_BACKOFF_SECONDS=1.5

# Scraping settings
SCRAPER_MAX_CHARS=4000

# Cache Settings (TTL in seconds: 86400 = 24 hours)
ENABLE_CACHE=true
CACHE_TTL_SECONDS=86400

# Observability
LOG_LEVEL=INFO
SAVE_TRACES=true
TRACES_DIR=./traces
